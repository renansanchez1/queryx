# --- Obrigatórias ---------------------------------------------------------

# O MESMO banco da API principal. Recomendado: usuário só de leitura nas
# collections de negócio + readWrite em `report_definitions`, e
# readPreference=secondaryPreferred pra relatório não disputar o primário.
MONGODB_URI=mongodb://usuario:senha@host:27017/licitta?readPreference=secondaryPreferred

# URL da API principal (LICITA+). No Railway, prefira a rede privada:
#   http://<nome-do-servico-api>.railway.internal:<PORT>
MAIN_API_URL=http://localhost:3001

# --- Opcionais --------------------------------------------------------------

# Banco, se não estiver na URI.
# MONGODB_DB=licitta

PORT=3000
NODE_ENV=production

# Fuso das datas dos relatórios (período, agrupamento por dia/semana/mês).
REPORTS_TIMEZONE=America/Sao_Paulo

# Jornada diária padrão, em minutos, para "horas acima da jornada".
STANDARD_WORKDAY_MINUTES=480

# Por quanto tempo a validação de sessão na API principal fica em cache.
# Revogação/desativação leva até esse tempo pra valer aqui.
AUTH_CACHE_TTL_SECONDS=15

# Tempo máximo de uma consulta no MongoDB.
QUERY_TIMEOUT_MS=15000

# Proxies confiáveis na frente do serviço (Railway = 1). false se exposto direto.
TRUST_PROXY=1

# Requisições por minuto por IP.
THROTTLE_LIMIT=300

# Cookie de sessão só em HTTPS (padrão: true em produção).
# COOKIE_SECURE=true

# Origens externas que podem chamar a API com Bearer (o próprio front não precisa).
# ALLOWED_ORIGINS=https://app.licitta.com.br
