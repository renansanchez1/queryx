{
  "name": "queryx",
  "version": "1.0.0",
  "private": true,
  "description": "LICITA+ Relatórios — microsserviço de relatórios (camada semântica sobre o MongoDB) com o front web",
  "main": "dist/main.js",
  "engines": {
    "node": "22.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "nest build",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "start": "node dist/main.js",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix web run typecheck"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "mongodb": "^6.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.1.3",
    "mingo": "^6.6.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
